{
  "expo": {
    "name": "mobile-checkin",
    "slug": "mobile-checkin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/expo.icon/app.png",
    "scheme": "mobilecheckin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon/app.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a2e"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "TicketBox Check-in cần quyền camera để quét mã QR vé.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
