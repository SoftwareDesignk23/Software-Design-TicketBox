DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticketbox?schema=public
JWT_ISSUER=ticketbox
JWT_AUDIENCE=ticketbox.clients
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
JWT_SIGNING_SECRET=replace-with-long-secret
REDIS_URL=redis://localhost:6379
BOOKING_RESERVATION_TTL_SECONDS=300
BOOKING_QUEUE_CONCURRENCY_LIMIT=250
BOOKING_ADMISSION_LEASE_TTL_SECONDS=60
BOOKING_ADMISSION_MAX_ATTEMPTS=3
BOOKING_RETRY_BUDGET=3
BOOKING_USER_TICKET_LIMIT_PER_EVENT=4
BOOKING_USER_TICKET_LIMIT_PER_TICKET_TYPE=4
BOOKING_QUEUE_ENABLED=false
