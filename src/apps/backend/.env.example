# ====== INFRASTRUCTURE ENV VARIABLES (Dùng cho Docker/Local) ======
# Database (Postgres)
# Nếu chạy Backend qua Docker trên Win/Mac, đổi 'localhost' thành 'host.docker.internal'
DATABASE_URL=postgresql://ticketbox:mysecretpassword@localhost:5432/ticketbox_db?schema=public
DIRECT_URL=postgresql://ticketbox:mysecretpassword@localhost:5432/ticketbox_db

# Message Broker & Cache (RabbitMQ & Redis)
RABBITMQ_URL=amqp://myuser:mypassword@localhost:5672/myvhost
REDIS_URL=redis://:MySecurePassword123@localhost:6379

# Object Storage 1 (S3-compatible: MinIO cho local, B2 cho cloud)
ENDPOINT_B2=localhost:9000
KEYID_B2=minioadmin
APPLICATIONKEY_B2=minioadminpassword
BUCKET_NAME=ticketbox-assets
PRESIGNED_URL_EXPIRATION_SECONDS=900


# ====== OTHER ENV VARIABLES (Tải từ Drive hoặc cung cấp thêm) ======
# JWT
JWT_ISSUER=ticketbox
JWT_AUDIENCE=ticketbox.clients
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=1209600
JWT_SIGNING_SECRET=replace-with-long-secret
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Ticket Secret
TICKET_SECRET_KEY=ticketbox-default-secret-key-2026

# Object Storage 2 (Ví dụ: Cloudinary)
API_SECRET_OBJECT_STORAGE=
API_KEY_OBJECT_STORAGE=
CLOUD_NAME_OBJECT_STORAGE=

# Third-party APIs (Email, AI Gemini)
API_KEY_EMAIL=
API_KEY_GEMINIS=

# Caching Configuration
CACHE_TTL=300
