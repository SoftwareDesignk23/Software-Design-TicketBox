generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  AUDIENCE
  ORGANIZER
  CHECK_IN_STAFF
  ADMIN
}

enum ConcertStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum TicketTypeStatus {
  ACTIVE
  PAUSED
  SOLD_OUT
}

enum BookingStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  VNPAY
  MOMO
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum TicketStatus {
  ISSUED
  CHECKED_IN
  VOIDED
}

enum CheckInStatus {
  ACCEPTED
  REJECTED
  DUPLICATE
  INVALID
  WRONG_EVENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  SOLD
  BLOCKED
}

// 1. Users
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  displayName   String
  phoneNumber   String?
  avatarUrl     String?
  role          Role
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens RefreshSession[]
  bookings      Booking[]
  tickets       Ticket[]
  checkInLogs   CheckInLog[]
  notifications Notification[]
  assignments   ConcertAssignment[]
}

model RefreshSession {
  id                String    @id @default(uuid())
  familyId          String
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  revokedAt         DateTime?
  replacedByTokenId String?
  lastUsedAt        DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model ConcertAssignment {
  id        String   @id @default(uuid())
  userId    String
  role      Role
  concertId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concert   Concert  @relation(fields: [concertId], references: [id], onDelete: Cascade)

  @@unique([userId, role, concertId])
  @@index([concertId])
}

// 2. Organizer, Sponsor, Artist, Venue
model Organizer {
  id          String    @id @default(uuid())
  name        String
  logoUrl     String?
  description String?   @db.Text
  website     String?
  email       String?
  concerts    Concert[]
}

model Sponsor {
  id          String    @id @default(uuid())
  name        String
  logoUrl     String?
  description String?   @db.Text
  concerts    ConcertSponsor[]
}

model Artist {
  id          String    @id @default(uuid())
  name        String
  avatarUrl   String?
  bio         String?   @db.Text
  socialLinks Json?     // e.g. { "facebook": "...", "instagram": "..." }
  concerts    ConcertArtist[]
}

model Venue {
  id           String    @id @default(uuid())
  name         String
  address      String
  mapUrl       String?
  capacity     Int
  concerts     Concert[]
  seatSections SeatSection[]
}

// 3. Concerts & Relations
model Concert {
  id               String          @id @default(uuid())
  title            String
  description      String?         @db.Text // Rich Text
  bannerUrl        String?
  heroImageUrl     String?
  seatMapUrl       String?
  status           ConcertStatus   @default(DRAFT)
  organizerId      String
  venueId          String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organizer        Organizer       @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  venue            Venue           @relation(fields: [venueId], references: [id], onDelete: Restrict)

  shows            ConcertShow[]
  artists          ConcertArtist[]
  sponsors         ConcertSponsor[]
  ticketTypes      TicketType[]
  assignments      ConcertAssignment[]
}

model ConcertArtist {
  concertId String
  artistId  String
  role      String    // "Ca sĩ chính", "Khách mời", "DJ", "MC"
  concert   Concert   @relation(fields: [concertId], references: [id], onDelete: Cascade)
  artist    Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([concertId, artistId])
}

model ConcertSponsor {
  concertId String
  sponsorId String
  tier      String?   // "Nhà tài trợ kim cương", "Nhà tài trợ vàng"
  concert   Concert   @relation(fields: [concertId], references: [id], onDelete: Cascade)
  sponsor   Sponsor   @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@id([concertId, sponsorId])
}

// 4. Schedule & Seats
model ConcertShow {
  id           String      @id @default(uuid())
  concertId    String
  startsAt     DateTime
  endsAt       DateTime?
  salesOpensAt DateTime?
  status       ConcertStatus @default(PUBLISHED)
  
  concert      Concert     @relation(fields: [concertId], references: [id], onDelete: Cascade)
  showSeats    ShowSeat[]
  tickets      Ticket[]
}

model SeatSection {
  id        String   @id @default(uuid())
  venueId   String
  name      String   // E.g. "Khu GA", "Khu VIP"
  capacity  Int
  sortOrder Int      @default(0)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  seats     Seat[]

  @@unique([venueId, name])
}

model Seat {
  id        String      @id @default(uuid())
  sectionId String
  label     String      // E.g. A1, B2
  row       String?
  number    Int?
  section   SeatSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  showSeats ShowSeat[]

  @@unique([sectionId, label])
}

model TicketType {
  id             String         @id @default(uuid())
  concertId      String
  name           String         // SVIP, VIP, GA
  price          Decimal        @db.Decimal(12, 2)
  currency       String         @default("VND")
  description    String?        @db.Text
  benefits       String?        @db.Text
  colorCode      String?
  maxPerOrder    Int            @default(4)
  totalQuantity  Int
  soldQuantity   Int            @default(0)
  status         TicketTypeStatus @default(ACTIVE)

  concert        Concert        @relation(fields: [concertId], references: [id], onDelete: Cascade)
  showSeats      ShowSeat[]
  bookingItems   BookingItem[]
  tickets        Ticket[]
}

// Inventory of Seats per Show
model ShowSeat {
  id             String      @id @default(uuid())
  showId         String
  seatId         String
  ticketTypeId   String
  status         SeatStatus  @default(AVAILABLE) // AVAILABLE, RESERVED, SOLD, BLOCKED
  
  show           ConcertShow @relation(fields: [showId], references: [id], onDelete: Cascade)
  seat           Seat        @relation(fields: [seatId], references: [id], onDelete: Cascade)
  ticketType     TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  bookingItems   BookingItem[]
  tickets        Ticket[]

  @@unique([showId, seatId])
}

// 5. Booking & Payment (Removed Reservation table, merged logic into Booking)
model Booking {
  id             String          @id @default(uuid())
  userId         String
  status         BookingStatus   @default(PENDING_PAYMENT)
  totalAmount    Decimal         @db.Decimal(12, 2)
  currency       String          @default("VND")
  expiresAt      DateTime
  idempotencyKey String?         @unique
  attendeeName   String?
  attendeeEmail  String?
  attendeePhone  String?
  attendeeIdCard String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          BookingItem[]
  payments       Payment[]
  tickets        Ticket[]
}

model BookingItem {
  id           String      @id @default(uuid())
  bookingId    String
  ticketTypeId String
  showSeatId   String?
  quantity     Int
  unitPrice    Decimal     @db.Decimal(12, 2)
  
  booking      Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketType   TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  showSeat     ShowSeat?   @relation(fields: [showSeatId], references: [id], onDelete: SetNull)
}

model Payment {
  id             String          @id @default(uuid())
  bookingId      String
  provider       PaymentProvider
  status         PaymentStatus   @default(PENDING)
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("VND")
  providerRef    String?
  rawPayload     Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([bookingId])
}

// 6. Tickets & Check-in
model Ticket {
  id            String        @id @default(uuid())
  bookingId     String
  showId        String
  ticketTypeId  String
  showSeatId    String?
  ownerId       String
  code          String        @unique // QR Code / Hash
  qrPayload     String
  status        TicketStatus  @default(ISSUED)
  issuedAt      DateTime      @default(now())
  checkedInAt   DateTime?
  
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  show          ConcertShow   @relation(fields: [showId], references: [id], onDelete: Cascade)
  ticketType    TicketType    @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  showSeat      ShowSeat?     @relation(fields: [showSeatId], references: [id], onDelete: SetNull)
  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  checkInLogs   CheckInLog[]

  @@index([ownerId])
  @@index([showId])
}

model CheckInLog {
  id            String        @id @default(uuid())
  ticketId      String
  staffId       String
  deviceId      String
  scannedAt     DateTime
  status        CheckInStatus
  isOfflineSync Boolean       @default(false)
  createdAt     DateTime      @default(now())
  
  ticket        Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staff         User          @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([deviceId])
}

model Notification {
  id           String              @id @default(uuid())
  userId       String
  type         String
  channel      NotificationChannel
  status       NotificationStatus  @default(PENDING)
  payload      Json?
  scheduledFor DateTime?
  sentAt       DateTime?
  isRead       Boolean             @default(false)
  createdAt    DateTime            @default(now())
  
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}
